# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required by:
#   - the data pipeline / migrations
#   - /api/delete-account (deleting a user needs the Supabase admin API)
# NEVER expose as NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FastAPI backend
NEXT_PUBLIC_API_URL=https://your-api.com

# Google Gemini (for Sparky chat)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Retail price calibration (wholesale → retail markup)
NEXT_PUBLIC_RETAIL_PRICE_FACTOR=1.2
